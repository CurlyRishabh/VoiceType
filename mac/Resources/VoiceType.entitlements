<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- PRIVACY: App Sandbox ON and NO com.apple.security.network.* entitlement, so macOS blocks
         every network connection from this app (and from every library inside it). -->
    <key>com.apple.security.app-sandbox</key><true/>
    <key>com.apple.security.device.audio-input</key><true/>
    <!-- Read-only access to the models folder you pick in the Open panel. -->
    <key>com.apple.security.files.user-selected.read-only</key><true/>
</dict>
</plist>
