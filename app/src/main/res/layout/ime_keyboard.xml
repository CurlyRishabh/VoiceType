<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_background"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/ime_tap_to_speak"
        android:textColor="@color/kb_key_text"
        android:textSize="14sp" />

    <dev.offline.voicetype.ui.LevelMeterView
        android:id="@+id/level"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="6dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="112dp">

        <ImageButton
            android:id="@+id/mic"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_mic"
            android:contentDescription="@string/cd_mic"
            android:elevation="4dp"
            android:scaleType="center"
            android:src="@drawable/ic_mic" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/switch_kb"
            style="@style/KeyboardKey"
            android:contentDescription="@string/cd_switch_keyboard"
            android:src="@drawable/ic_keyboard" />

        <ImageButton
            android:id="@+id/settings"
            style="@style/KeyboardKey"
            android:contentDescription="@string/cd_settings"
            android:src="@drawable/ic_settings" />

        <ImageButton
            android:id="@+id/space"
            style="@style/KeyboardKey"
            android:layout_weight="3"
            android:contentDescription="@string/cd_space"
            android:src="@drawable/ic_space" />

        <ImageButton
            android:id="@+id/backspace"
            style="@style/KeyboardKey"
            android:contentDescription="@string/cd_backspace"
            android:src="@drawable/ic_backspace" />

        <ImageButton
            android:id="@+id/enter"
            style="@style/KeyboardKey"
            android:contentDescription="@string/cd_enter"
            android:src="@drawable/ic_enter" />
    </LinearLayout>
</LinearLayout>
