<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VoiceType" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorSecondary">@color/brand</item>
    </style>

    <!-- Fully transparent, used by MicAccessActivity (finishes immediately). -->
    <style name="Theme.VoiceType.Invisible" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="KeyboardKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/kb_key_text</item>
    </style>
</resources>
